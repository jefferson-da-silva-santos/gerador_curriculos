# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA cometa o .env no Git.

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# ─── Cloudinary (upload de fotos do currículo) ────────────────────────────────
# Pegue esses 3 valores no Dashboard do Cloudinary (cloudinary.com/console):
# eles ficam juntos em "API Environment variable" ou separados em
# "Cloud name" / "API Key" / "API Secret".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
