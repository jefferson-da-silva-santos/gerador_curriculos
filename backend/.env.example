# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA cometa o .env no Git.

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development

# ─── Cloudinary (upload de fotos do currículo) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Banco de dados (Neon Postgres) — histórico de pagamentos ────────────────
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/db?sslmode=require"


# ─── Mercado Pago (cobrança via Pix) ──────────────────────────────────────────
# Dashboard: https://www.mercadopago.com.br/developers/panel
# Comece com as credenciais de TESTE antes de ir pra produção.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública do seu backend + /pagamento/webhook (precisa ser https em produção;
# em desenvolvimento local, use um túnel como ngrok pra testar o webhook de verdade)
MERCADOPAGO_WEBHOOK_URL=https://seu-dominio.com/pagamento/webhook
# Gerado no dashboard, na configuração do webhook — usado para validar
# que a chamada realmente veio do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=

# Valor cobrado por currículo gerado, em reais
PAYMENT_AMOUNT=5.00
