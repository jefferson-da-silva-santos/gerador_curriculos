# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA cometa o .env no Git.

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development

# ─── Puppeteer (geração de PDF) ───────────────────────────────────────────────
# Só necessário rodando LOCALMENTE (fora da Vercel). Aponte para o
# Chrome/Chromium instalado na sua máquina — puppeteer-core não baixa
# nenhum binário sozinho.
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
# Na Vercel, isso é resolvido automaticamente via @sparticuz/chromium —
# não precisa configurar nada lá.
PUPPETEER_EXECUTABLE_PATH=

# ─── Cloudinary (upload de fotos do currículo) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Banco de dados (Neon Postgres) — histórico de pagamentos ────────────────
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/db?sslmode=require"

# ─── Mercado Pago (cobrança via Pix) ──────────────────────────────────────────
# Dashboard: https://www.mercadopago.com.br/developers/panel
# Comece com as credenciais de TESTE antes de ir pra produção.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública do seu backend + /pagamento/webhook (precisa ser https em produção;
# em desenvolvimento local, use um túnel como ngrok pra testar o webhook de verdade)
MERCADOPAGO_WEBHOOK_URL=https://seu-dominio.com/pagamento/webhook
# Gerado no dashboard, na configuração do webhook — usado para validar que a
# chamada realmente veio do Mercado Pago. OBRIGATÓRIO em produção (o servidor
# recusa subir sem isso quando NODE_ENV=production).
MERCADOPAGO_WEBHOOK_SECRET=

# Valor cobrado por currículo gerado, em reais
PAYMENT_AMOUNT=5.00

# ─── Upstash Redis (rate limiting distribuído) ────────────────────────────────
# Necessário em produção na Vercel — crie um banco gratuito em
# https://upstash.com/ (aba REST API do banco criado, copie os dois valores).
# Sem isso, o rate limiting cai para memória local, que não protege de forma
# confiável contra abuso distribuído entre instâncias de função serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
